{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alerta",
  "description": "Payload MQTT en secadero/<camara>/alertas (publica Node-RED)",
  "type": "object",
  "required": ["ts", "camara", "lote_id", "severidad", "mensaje"],
  "additionalProperties": false,
  "properties": {
    "ts": { "type": "string", "format": "date-time" },
    "camara": { "type": "string", "pattern": "^c[0-9]{2}$" },
    "lote_id": { "type": ["integer", "null"] },
    "severidad": { "enum": ["amarilla", "roja"] },
    "mensaje": { "type": "string", "minLength": 1 }
  }
}
