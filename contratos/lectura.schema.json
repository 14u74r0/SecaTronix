{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lectura",
  "description": "Payload MQTT en secadero/<camara>/<nodo>/<variable>",
  "type": "object",
  "required": ["ts", "camara", "nodo", "variable", "valor", "unidad"],
  "additionalProperties": false,
  "properties": {
    "ts": { "type": "string", "format": "date-time", "description": "ISO-8601 UTC, ej. 2026-10-22T14:40:00Z" },
    "camara": { "type": "string", "pattern": "^c[0-9]{2}$" },
    "nodo": { "type": "string", "pattern": "^n[0-9]{2}$" },
    "variable": { "enum": ["temp_aire", "hr_aire", "humedad_madera"] },
    "valor": { "type": "number" },
    "unidad": { "enum": ["°C", "%"] }
  }
}
